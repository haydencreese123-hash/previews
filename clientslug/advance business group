<script>
(function(){
  "use strict";

  /* ---------- year ---------- */
  document.getElementById('yr').textContent = new Date().getFullYear();

  /* ---------- header + mobile nav ---------- */
  var hdr = document.getElementById('hdr'),
      burger = document.getElementById('burger'),
      mobile = document.getElementById('mobile'),
      topBtn = document.getElementById('top');

  burger.addEventListener('click', function(){
    var open = mobile.classList.toggle('show');
    burger.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  mobile.addEventListener('click', function(e){
    if(e.target.tagName === 'A'){
      mobile.classList.remove('show');
      burger.classList.remove('open');
      burger.setAttribute('aria-expanded','false');
    }
  });

  window.addEventListener('scroll', function(){
    hdr.classList.toggle('scrolled', window.scrollY > 8);
    topBtn.classList.toggle('show', window.scrollY > 520);
  }, {passive:true});

  topBtn.addEventListener('click', function(){ window.scrollTo({top:0, behavior:'smooth'}); });

  /* ---------- scrollspy ---------- */
  var navLinks = Array.prototype.slice.call(document.querySelectorAll('#navlinks a'));
  var sections = navLinks.map(function(a){ return document.querySelector(a.getAttribute('href')); });
  if('IntersectionObserver' in window){
    var spy = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(en.isIntersecting){
          navLinks.forEach(function(a,i){ a.classList.toggle('active', sections[i] === en.target); });
        }
      });
    }, {rootMargin:'-45% 0px -50% 0px'});
    sections.forEach(function(s){ if(s) spy.observe(s); });
  }

  /* ---------- reveal on scroll ---------- */
  var reveals = document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window){
    var ro = new IntersectionObserver(function(entries, obs){
      entries.forEach(function(en){
        if(en.isIntersecting){ en.target.classList.add('in'); obs.unobserve(en.target); }
      });
    }, {threshold:.12});
    reveals.forEach(function(el){ ro.observe(el); });
  } else {
    reveals.forEach(function(el){ el.classList.add('in'); });
  }

  /* ---------- animated stat counters ---------- */
  var counted = false;
  function runCounters(){
    if(counted) return; counted = true;
    document.querySelectorAll('[data-count]').forEach(function(el){
      var target = parseFloat(el.getAttribute('data-count')),
          dec = parseInt(el.getAttribute('data-dec') || '0', 10),
          start = performance.now(), dur = 1100;
      function step(now){
        var p = Math.min((now - start)/dur, 1);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = (target * eased).toFixed(dec);
        if(p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });
  }
  var statsEl = document.querySelector('.stats');
  if('IntersectionObserver' in window && statsEl){
    new IntersectionObserver(function(en, o){
      if(en[0].isIntersecting){ runCounters(); o.disconnect(); }
    }, {threshold:.4}).observe(statsEl);
  } else { runCounters(); }

  /* ---------- rating bars ---------- */
  var barsEl = document.getElementById('bars');
  function fillBars(){
    barsEl.querySelectorAll('i').forEach(function(i){ i.style.width = i.getAttribute('data-w') + '%'; });
  }
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(en, o){
      if(en[0].isIntersecting){ fillBars(); o.disconnect(); }
    }, {threshold:.4}).observe(barsEl);
  } else { fillBars(); }

  /* ---------- service tabs ---------- */
  var tabs = document.querySelectorAll('.tab'),
      panels = document.querySelectorAll('.panel');
  tabs.forEach(function(t){
    t.addEventListener('click', function(){
      var idx = t.getAttribute('data-tab');
      tabs.forEach(function(x){ x.setAttribute('aria-selected', x === t ? 'true' : 'false'); });
      panels.forEach(function(p){ p.classList.toggle('show', p.getAttribute('data-panel') === idx); });
    });
  });

  /* ---------- review carousel ---------- */
  var slides = document.querySelectorAll('#slides .slide'),
      dotsEl = document.getElementById('dots'),
      cur = 0, timer;

  slides.forEach(function(_, i){
    var d = document.createElement('button');
    d.className = 'dot' + (i === 0 ? ' on' : '');
    d.setAttribute('aria-label', 'Review ' + (i+1));
    d.addEventListener('click', function(){ go(i); restart(); });
    dotsEl.appendChild(d);
  });
  var dots = dotsEl.querySelectorAll('.dot');

  function go(i){
    cur = (i + slides.length) % slides.length;
    slides.forEach(function(s, n){ s.classList.toggle('show', n === cur); });
    dots.forEach(function(d, n){ d.classList.toggle('on', n === cur); });
  }
  function restart(){ clearInterval(timer); timer = setInterval(function(){ go(cur + 1); }, 8000); }
  document.getElementById('next').addEventListener('click', function(){ go(cur + 1); restart(); });
  document.getElementById('prev').addEventListener('click', function(){ go(cur - 1); restart(); });
  restart();

  /* ---------- comparison table ---------- */
  var firms = [
    {name:'Advance Business Group, Inc', cat:'Business management consultant', rating:5.0, count:2, me:true},
    {name:'Advanced Management & Solutions', cat:'Business to business service', rating:5.0, count:1},
    {name:'ActionCOACH MN', cat:'Business management consultant', rating:5.0, count:37},
    {name:'Advance Consulting LLC', cat:'Consultant', rating:null, count:0},
    {name:'Smart Business Consultants, Inc', cat:'Consultant', rating:null, count:0},
    {name:'Strategic Business Ventures, Inc.', cat:'Business management consultant', rating:5.0, count:2}
  ];
  var sortKey = 'rating', sortDir = -1;
  var tbody = document.getElementById('tbody'),
      emptyEl = document.getElementById('empty'),
      qEl = document.getElementById('q'),
      catEl = document.getElementById('cat'),
      revEl = document.getElementById('rev');

  function starStr(r){
    if(r === null) return '<span class="muted">—</span>';
    return '<span class="mini-stars">' + '★'.repeat(Math.round(r)) + '</span> <b style="color:var(--navy)">' + r.toFixed(1) + '</b>';
  }
  function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

  function render(){
    var q = qEl.value.trim().toLowerCase(),
        c = catEl.value,
        r = revEl.value;

    var rows = firms.filter(function(f){
      if(q && f.name.toLowerCase().indexOf(q) === -1 && f.cat.toLowerCase().indexOf(q) === -1) return false;
      if(c && f.cat !== c) return false;
      if(r === 'has' && f.count === 0) return false;
      if(r === 'none' && f.count > 0) return false;
      return true;
    });

    rows.sort(function(a, b){
      var av = a[sortKey], bv = b[sortKey];
      if(av === null) av = -1;
      if(bv === null) bv = -1;
      if(typeof av === 'string') return av.localeCompare(bv) * sortDir;
      return (av - bv) * sortDir;
    });

    tbody.innerHTML = rows.map(function(f){
      return '<tr class="' + (f.me ? 'me' : '') + '">' +
        '<td><b style="color:var(--navy)">' + esc(f.name) + '</b>' + (f.me ? '<span class="pill">That\'s us</span>' : '') + '</td>' +
        '<td class="muted">' + esc(f.cat) + '</td>' +
        '<td>' + starStr(f.rating) + '</td>' +
        '<td>' + (f.count === 0 ? '<span class="muted">No reviews</span>' : f.count) + '</td>' +
      '</tr>';
    }).join('');

    emptyEl.style.display = rows.length ? 'none' : 'block';
  }

  document.querySelectorAll('#tbl th').forEach(function(th){
    th.addEventListener('click', function(){
      var k = th.getAttribute('data-key');
      if(k === sortKey){ sortDir *= -1; } else { sortKey = k; sortDir = (k === 'name' || k === 'cat') ? 1 : -1; }
      document.querySelectorAll('#tbl th').forEach(function(x){ x.classList.toggle('sorted', x === th); });
      th.querySelector('.caret').textContent = sortDir === 1 ? '▴' : '▾';
      render();
    });
  });
  [qEl, catEl, revEl].forEach(function(el){ el.addEventListener('input', render); });
  document.getElementById('reset').addEventListener('click', function(){
    qEl.value = ''; catEl.value = ''; revEl.value = 'all';
    sortKey = 'rating'; sortDir = -1;
    render();
  });
  render();

  /* ---------- hours + open/closed status ---------- */
  var HOURS = [
    {d:'Sunday',    open:null, close:null},
    {d:'Monday',    open:8*60, close:17*60},
    {d:'Tuesday',   open:8*60, close:17*60},
    {d:'Wednesday', open:8*60, close:17*60},
    {d:'Thursday',  open:8*60, close:17*60},
    {d:'Friday',    open:8*60, close:17*60},
    {d:'Saturday',  open:null, close:null}
  ];

  function centralNow(){
    // Interpret "now" in America/Chicago regardless of the visitor's timezone.
    var s = new Date().toLocaleString('en-US', {timeZone:'America/Chicago'});
    return new Date(s);
  }
  function fmt(mins){
    var h = Math.floor(mins/60), m = mins % 60,
        ap = h >= 12 ? 'PM' : 'AM',
        hh = h % 12 === 0 ? 12 : h % 12;
    return hh + ':' + (m < 10 ? '0' : '') + m + ' ' + ap;
  }

  var now = centralNow(),
      day = now.getDay(),
      mins = now.getHours()*60 + now.getMinutes(),
      today = HOURS[day],
      isOpen = today.open !== null && mins >= today.open && mins < today.close;

  // hours list, starting Monday
  var order = [1,2,3,4,5,6,0];
  document.getElementById('hoursList').innerHTML = order.map(function(i){
    var h = HOURS[i];
    return '<li class="' + (i === day ? 'today' : '') + '"><span>' + h.d + '</span><span>' +
      (h.open === null ? 'Closed' : fmt(h.open) + ' – ' + fmt(h.close)) + '</span></li>';
  }).join('');

  var pill = document.getElementById('statusPill'),
      txt = document.getElementById('statusText'),
      sub = document.getElementById('statusSub'),
      heroBadge = document.getElementById('heroStatus');

  function nextOpenLabel(){
    for(var k = 1; k <= 7; k++){
      var nd = HOURS[(day + k) % 7];
      if(nd.open !== null) return (k === 1 ? 'tomorrow' : nd.d) + ' at ' + fmt(nd.open);
    }
    return '';
  }

  if(isOpen){
    var left = today.close - mins;
    pill.className = 'status open';
    txt.textContent = 'Open now';
    sub.textContent = left <= 60
      ? 'Closes soon — ' + fmt(today.close) + ' (in ' + left + ' min)'
      : 'Closes at ' + fmt(today.close) + ' CT';
    heroBadge.textContent = '● Open now · closes ' + fmt(today.close) + ' CT';
  } else {
    pill.className = 'status shut';
    txt.textContent = 'Closed now';
    var label = (today.open !== null && mins < today.open)
      ? 'today at ' + fmt(today.open)
      : nextOpenLabel();
    sub.textContent = 'Opens ' + label + ' CT';
    heroBadge.textContent = '● Closed · opens ' + label + ' CT';
  }

  /* ---------- copy buttons ---------- */
  document.querySelectorAll('.copy').forEach(function(b){
    b.addEventListener('click', function(){
      var val = b.getAttribute('data-copy'), old = b.textContent;
      function done(){ b.textContent = 'Copied ✓'; setTimeout(function(){ b.textContent = old; }, 1600); }
      if(navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(val).then(done, function(){ b.textContent = 'Press ⌘C'; });
      } else {
        var ta = document.createElement('textarea');
        ta.value = val; document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); done(); } catch(e){ b.textContent = 'Press ⌘C'; }
        document.body.removeChild(ta);
      }
    });
  });

  /* ---------- contact form validation ---------- */
  var form = document.getElementById('form'), sentEl = document.getElementById('sent');
  function setBad(id, bad){ document.getElementById(id).classList.toggle('bad', bad); }

  form.addEventListener('submit', function(e){
    e.preventDefault();
    var name = document.getElementById('name').value.trim(),
        email = document.getElementById('email').value.trim(),
        topic = document.getElementById('topic').value,
        msg = document.getElementById('msg').value.trim(),
        ok = true;

    if(!name){ setBad('f-name', true); ok = false; } else setBad('f-name', false);
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)){ setBad('f-email', true); ok = false; } else setBad('f-email', false);
    if(!topic){ setBad('f-topic', true); ok = false; } else setBad('f-topic', false);
    if(msg.length < 10){ setBad('f-msg', true); ok = false; } else setBad('f-msg', false);

    if(!ok){
      var firstBad = form.querySelector('.field.bad input, .field.bad select, .field.bad textarea');
      if(firstBad) firstBad.focus();
      return;
    }
    sentEl.classList.add('show');
    sentEl.scrollIntoView({behavior:'smooth', block:'center'});
    form.reset();
  });

  form.addEventListener('input', function(e){
    var f = e.target.closest('.field');
    if(f && f.classList.contains('bad')) f.classList.remove('bad');
  });
})();
</script>
</body>
</html>
