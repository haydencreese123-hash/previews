<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Advance Business Group, Inc — Business Management Consulting | Brooklyn Park, MN</title>
<meta name="description" content="Advance Business Group, Inc. is a women-owned business management consulting firm in Brooklyn Park, Minnesota. Strategic planning, process improvement, leadership coaching and executive facilitation.">
<!-- SPEC PREVIEW ONLY: keep this noindex tag until the client approves and this goes on their own domain. -->
<meta name="robots" content="noindex, nofollow">
<style>
  :root{
    --navy:#0f2540;
    --navy-800:#16355c;
    --navy-600:#254a78;
    --slate:#475569;
    --slate-light:#64748b;
    --line:#e2e8f0;
    --bg:#ffffff;
    --bg-alt:#f6f8fb;
    --accent:#c9a227;
    --accent-soft:#f5edd4;
    --ok:#15803d;
    --closed:#b91c1c;
    --radius:14px;
    --maxw:1140px;
    --shadow:0 1px 3px rgba(15,37,64,.06), 0 12px 32px rgba(15,37,64,.07);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;scroll-padding-top:78px}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;
    color:var(--slate);background:var(--bg);line-height:1.65;-webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,h4{color:var(--navy);line-height:1.2;font-weight:700;letter-spacing:-.02em}
  h1{font-size:clamp(2.1rem,4.6vw,3.4rem)}
  h2{font-size:clamp(1.6rem,3vw,2.3rem)}
  h3{font-size:1.15rem}
  a{color:var(--navy-600);text-decoration:none}
  a:hover{text-decoration:underline}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
  section{padding:86px 0}
  .eyebrow{
    font-size:.76rem;letter-spacing:.16em;text-transform:uppercase;
    font-weight:700;color:var(--accent);margin-bottom:12px
  }
  .lede{font-size:1.06rem;max-width:62ch}

  /* ---------- header ---------- */
  header{
    position:sticky;top:0;z-index:60;background:rgba(255,255,255,.92);
    backdrop-filter:saturate(180%) blur(12px);border-bottom:1px solid var(--line);
    transition:box-shadow .25s ease;
  }
  header.scrolled{box-shadow:0 4px 20px rgba(15,37,64,.08)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:74px}
  .brand{display:flex;align-items:center;gap:11px;color:var(--navy);font-weight:800;letter-spacing:-.02em}
  .brand:hover{text-decoration:none}
  .mark{
    width:38px;height:38px;border-radius:10px;flex:none;
    background:linear-gradient(140deg,var(--navy) 0%,var(--navy-600) 100%);
    display:grid;place-items:center;color:#fff;font-size:1rem;font-weight:800;letter-spacing:-.04em;
  }
  .brand span.n{font-size:1.02rem;display:block}
  .brand span.t{font-size:.7rem;color:var(--slate-light);font-weight:600;letter-spacing:.06em;text-transform:uppercase}
  .links{display:flex;align-items:center;gap:30px}
  .links a{color:var(--slate);font-size:.93rem;font-weight:600;position:relative}
  .links a:hover{color:var(--navy);text-decoration:none}
  .links a::after{
    content:"";position:absolute;left:0;bottom:-6px;height:2px;width:0;background:var(--accent);transition:width .22s ease
  }
  .links a:hover::after,.links a.active::after{width:100%}
  .btn{
    display:inline-flex;align-items:center;gap:8px;border:none;cursor:pointer;font-family:inherit;
    padding:12px 22px;border-radius:9px;font-weight:700;font-size:.92rem;transition:.18s ease;
  }
  .btn-primary{background:var(--navy);color:#fff}
  .btn-primary:hover{background:var(--navy-800);text-decoration:none;transform:translateY(-1px)}
  .btn-ghost{background:#fff;color:var(--navy);border:1.5px solid var(--line)}
  .btn-ghost:hover{border-color:var(--navy);text-decoration:none}
  .burger{display:none;background:none;border:none;cursor:pointer;padding:8px;flex-direction:column;gap:5px}
  .burger i{display:block;width:22px;height:2px;background:var(--navy);border-radius:2px;transition:.25s}
  .burger.open i:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .burger.open i:nth-child(2){opacity:0}
  .burger.open i:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .mobile{display:none;border-top:1px solid var(--line);background:#fff}
  .mobile.show{display:block}
  .mobile a{display:block;padding:15px 24px;border-bottom:1px solid var(--line);color:var(--navy);font-weight:600}

  /* ---------- hero ---------- */
  .hero{
    background:linear-gradient(165deg,#0f2540 0%,#1c3f68 58%,#254a78 100%);
    color:#dbe6f2;padding:92px 0 96px;position:relative;overflow:hidden
  }
  .hero::after{
    content:"";position:absolute;right:-140px;top:-140px;width:520px;height:520px;border-radius:50%;
    background:radial-gradient(circle,rgba(201,162,39,.16) 0%,transparent 68%)
  }
  .hero .wrap{position:relative;z-index:2}
  .hero h1{color:#fff;max-width:16ch}
  .hero p{margin-top:20px;font-size:1.12rem;max-width:56ch;color:#c3d3e6}
  .badges{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:24px}
  .badge{
    display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.11);
    border:1px solid rgba(255,255,255,.19);color:#e8f0f8;padding:6px 13px;border-radius:999px;
    font-size:.79rem;font-weight:600
  }
  .badge.gold{background:rgba(201,162,39,.17);border-color:rgba(201,162,39,.42);color:#f0dfa8}
  .hero-cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}
  .hero-cta .btn-primary{background:var(--accent);color:#2b2205}
  .hero-cta .btn-primary:hover{background:#d9b134}
  .hero-cta .btn-ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.34)}
  .hero-cta .btn-ghost:hover{background:rgba(255,255,255,.1);border-color:#fff}

  /* ---------- stats ---------- */
  .stats{background:var(--bg-alt);border-bottom:1px solid var(--line);padding:0}
  .stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line)}
  .stat{background:var(--bg-alt);padding:34px 20px;text-align:center}
  .stat b{display:block;font-size:2rem;color:var(--navy);font-weight:800;letter-spacing:-.03em}
  .stat span{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--slate-light);font-weight:700}

  /* ---------- services (tabs) ---------- */
  .tabs{display:flex;flex-wrap:wrap;gap:8px;margin:30px 0 26px;border-bottom:1px solid var(--line)}
  .tab{
    background:none;border:none;cursor:pointer;font-family:inherit;font-size:.93rem;font-weight:700;
    color:var(--slate-light);padding:12px 18px;border-bottom:3px solid transparent;margin-bottom:-1px;transition:.18s
  }
  .tab:hover{color:var(--navy)}
  .tab[aria-selected="true"]{color:var(--navy);border-bottom-color:var(--accent)}
  .panel{display:none;animation:fade .35s ease}
  .panel.show{display:grid;grid-template-columns:1.15fr .85fr;gap:44px;align-items:start}
  @keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .panel h3{font-size:1.5rem;margin-bottom:12px}
  .panel ul{list-style:none;margin-top:20px;display:grid;gap:11px}
  .panel li{padding-left:28px;position:relative;font-size:.97rem}
  .panel li::before{
    content:"";position:absolute;left:0;top:.55em;width:14px;height:8px;border-left:2.5px solid var(--accent);
    border-bottom:2.5px solid var(--accent);transform:rotate(-45deg)
  }
  .panel-aside{
    background:var(--bg-alt);border:1px solid var(--line);border-radius:var(--radius);padding:28px;
  }
  .panel-aside h4{font-size:.76rem;letter-spacing:.14em;text-transform:uppercase;color:var(--slate-light);margin-bottom:14px}
  .panel-aside p{font-size:.95rem;font-style:italic;color:var(--navy-800)}

  /* ---------- reviews ---------- */
  .reviews{background:var(--bg-alt)}
  .rating-hero{display:flex;flex-wrap:wrap;align-items:center;gap:22px;margin:26px 0 34px}
  .big-score{font-size:3.6rem;font-weight:800;color:var(--navy);letter-spacing:-.04em;line-height:1}
  .stars{color:var(--accent);font-size:1.35rem;letter-spacing:3px}
  .bars{flex:1;min-width:250px;max-width:340px;display:grid;gap:5px}
  .bar-row{display:flex;align-items:center;gap:10px;font-size:.8rem;color:var(--slate-light)}
  .bar{flex:1;height:8px;background:var(--line);border-radius:99px;overflow:hidden}
  .bar i{display:block;height:100%;background:var(--accent);width:0;transition:width 1s cubic-bezier(.2,.8,.2,1)}
  .carousel{position:relative;background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
  .slides{overflow:hidden}
  .slide{display:none;padding:38px 44px}
  .slide.show{display:block;animation:fade .35s ease}
  .slide .quote{font-size:1.08rem;color:var(--navy-800);line-height:1.75}
  .slide .quote::before{content:"“";font-size:2.6rem;color:var(--accent);line-height:0;vertical-align:-.35em;margin-right:4px}
  .who{display:flex;align-items:center;gap:13px;margin-top:26px;padding-top:22px;border-top:1px solid var(--line)}
  .avatar{
    width:44px;height:44px;border-radius:50%;background:var(--navy-600);color:#fff;flex:none;
    display:grid;place-items:center;font-weight:800;font-size:.95rem
  }
  .who b{display:block;color:var(--navy);font-size:.96rem}
  .who small{color:var(--slate-light);font-size:.82rem}
  .car-nav{display:flex;align-items:center;justify-content:space-between;padding:0 44px 26px}
  .dots{display:flex;gap:8px}
  .dot{width:9px;height:9px;border-radius:50%;border:none;background:var(--line);cursor:pointer;padding:0;transition:.2s}
  .dot.on{background:var(--accent);width:26px;border-radius:99px}
  .arrows{display:flex;gap:8px}
  .arrow{
    width:38px;height:38px;border-radius:9px;border:1.5px solid var(--line);background:#fff;cursor:pointer;
    color:var(--navy);font-size:1rem;display:grid;place-items:center;transition:.18s
  }
  .arrow:hover{border-color:var(--navy);background:var(--navy);color:#fff}

  /* ---------- compare table ---------- */
  .toolbar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin:26px 0 18px}
  .toolbar input,.toolbar select{
    font-family:inherit;font-size:.9rem;padding:10px 14px;border:1.5px solid var(--line);
    border-radius:9px;color:var(--navy);background:#fff;outline:none
  }
  .toolbar input{flex:1;min-width:200px}
  .toolbar input:focus,.toolbar select:focus{border-color:var(--navy-600)}
  .tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:var(--radius);background:#fff}
  table{width:100%;border-collapse:collapse;font-size:.93rem;min-width:620px}
  th{
    text-align:left;padding:15px 20px;background:var(--bg-alt);color:var(--navy);font-size:.75rem;
    letter-spacing:.1em;text-transform:uppercase;font-weight:800;border-bottom:1px solid var(--line);
    cursor:pointer;user-select:none;white-space:nowrap
  }
  th:hover{background:#eef2f8}
  th .caret{opacity:.35;font-size:.7rem;margin-left:5px}
  th.sorted .caret{opacity:1;color:var(--accent)}
  td{padding:15px 20px;border-bottom:1px solid var(--line);vertical-align:middle}
  tr:last-child td{border-bottom:none}
  tr.me{background:#fbf7e8}
  tr.me td:first-child{box-shadow:inset 3px 0 0 var(--accent)}
  .pill{display:inline-block;font-size:.72rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
    background:var(--accent-soft);color:#7a6210;padding:3px 9px;border-radius:99px;margin-left:8px}
  .mini-stars{color:var(--accent);letter-spacing:1px}
  .muted{color:var(--slate-light)}
  .empty{padding:28px 20px;text-align:center;color:var(--slate-light);font-size:.92rem}

  /* ---------- visit / contact ---------- */
  .visit{background:var(--bg-alt)}
  .split{display:grid;grid-template-columns:1fr 1fr;gap:44px;margin-top:34px;align-items:start}
  .card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:30px;box-shadow:var(--shadow)}
  .info-row{display:flex;gap:14px;padding:15px 0;border-bottom:1px solid var(--line)}
  .info-row:last-of-type{border-bottom:none}
  .ico{
    width:38px;height:38px;border-radius:9px;background:var(--bg-alt);flex:none;display:grid;place-items:center;
    font-size:1rem
  }
  .info-row b{display:block;color:var(--navy);font-size:.79rem;text-transform:uppercase;letter-spacing:.09em;margin-bottom:2px}
  .info-row .val{color:var(--slate);font-size:.96rem}
  .copy{
    background:none;border:none;cursor:pointer;font-family:inherit;color:var(--navy-600);font-size:.78rem;
    font-weight:700;padding:2px 0;margin-left:auto;white-space:nowrap
  }
  .copy:hover{text-decoration:underline}
  .status{
    display:inline-flex;align-items:center;gap:7px;font-weight:800;font-size:.85rem;padding:5px 12px;
    border-radius:99px;margin-bottom:14px
  }
  .status.open{background:#dcfce7;color:var(--ok)}
  .status.shut{background:#fee2e2;color:var(--closed)}
  .status .pulse{width:7px;height:7px;border-radius:50%;background:currentColor;animation:pulse 2s infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
  .hours{list-style:none;font-size:.93rem}
  .hours li{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px dashed var(--line)}
  .hours li:last-child{border-bottom:none}
  .hours li.today{font-weight:800;color:var(--navy)}
  .hours li.today::after{content:"Today";font-size:.68rem;background:var(--navy);color:#fff;padding:2px 7px;
    border-radius:99px;margin-left:10px;letter-spacing:.06em}
  .hours li span:last-child{color:var(--slate)}
  .map-frame{border:0;width:100%;height:330px;display:block;border-radius:var(--radius);border:1px solid var(--line)}

  form{display:grid;gap:16px}
  .field label{display:block;font-size:.79rem;font-weight:800;color:var(--navy);text-transform:uppercase;
    letter-spacing:.09em;margin-bottom:6px}
  .field input,.field select,.field textarea{
    width:100%;font-family:inherit;font-size:.96rem;padding:12px 14px;border:1.5px solid var(--line);
    border-radius:9px;color:var(--navy);outline:none;transition:.18s;background:#fff
  }
  .field textarea{resize:vertical;min-height:118px}
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--navy-600);box-shadow:0 0 0 3px rgba(37,74,120,.1)}
  .field.bad input,.field.bad select,.field.bad textarea{border-color:var(--closed)}
  .err{color:var(--closed);font-size:.79rem;font-weight:600;margin-top:5px;display:none}
  .field.bad .err{display:block}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .sent{
    display:none;background:#dcfce7;border:1px solid #86efac;color:#14532d;padding:18px 20px;
    border-radius:10px;font-size:.94rem
  }
  .sent.show{display:block;animation:fade .35s ease}
  .note{font-size:.79rem;color:var(--slate-light)}

  footer{background:var(--navy);color:#a9bdd4;padding:56px 0 28px;font-size:.9rem}
  .fgrid{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:40px;padding-bottom:34px;border-bottom:1px solid rgba(255,255,255,.12)}
  footer h5{color:#fff;font-size:.78rem;letter-spacing:.13em;text-transform:uppercase;margin-bottom:14px}
  footer a{color:#a9bdd4;display:block;padding:4px 0}
  footer a:hover{color:#fff}
  .fbot{padding-top:22px;display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;font-size:.82rem;color:#7f97b3}

  #top{
    position:fixed;right:24px;bottom:24px;width:46px;height:46px;border-radius:50%;border:none;cursor:pointer;
    background:var(--navy);color:#fff;font-size:1.1rem;box-shadow:var(--shadow);opacity:0;pointer-events:none;
    transition:.25s;z-index:50
  }
  #top.show{opacity:1;pointer-events:auto}
  #top:hover{background:var(--navy-800);transform:translateY(-2px)}

  .reveal{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s ease}
  .reveal.in{opacity:1;transform:none}

  @media(max-width:900px){
    .stat-grid{grid-template-columns:repeat(2,1fr)}
    .panel.show,.split,.two{grid-template-columns:1fr}
    .fgrid{grid-template-columns:1fr;gap:28px}
  }
  @media(max-width:760px){
    .links,.nav .btn{display:none}
    .burger{display:flex}
    section{padding:60px 0}
    .slide,.car-nav{padding-left:26px;padding-right:26px}
  }
  @media(prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important}
    html{scroll-behavior:auto}
    .reveal{opacity:1;transform:none}
  }
</style>
</head>
